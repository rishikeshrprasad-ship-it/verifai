# Copy to .env and fill in YOUR OWN values. Never commit .env.
# Every value below is a placeholder, not a real credential.

# --- Evidence sources ---
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_key_here
SERPER_API_KEY=your_serper_key_here
TAVILY_API_KEY=
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=verifai/0.1 by your_reddit_username

# --- LLM (claim extraction + explanations) ---
LLM_API_KEY=your_llm_key_here
LLM_MODEL=your_model_name_here

# --- App ---
DATABASE_URL=sqlite:///./verifai.db
ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5
RELEVANCE_THRESHOLD=0.4
MIN_EVIDENCE_COUNT=2
ENV=development

# --- OCR (set only if tesseract is not on PATH, e.g. Windows) ---
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000
